+
+package cpu
+
+const cacheLineSize = 64
+
+const IsBigEndian = false
+
+func initOptions() {
+    // e2k: детекция CPU-фич не используется, все флаги считаем выключенными
+}
+
+// e2k: детекции CPU-фич нет (ни HWCAP, ни CPUID). Generic archInit из
+// cpu_linux.go вызывает readHWCAP/hostByteOrder, которые не знают про Elbrus
+// и падают с "unknown architecture" — поэтому для e2k арх-инит пустой.
+func archInit() {
+}
